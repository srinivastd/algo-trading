#!/usr/bin/env sh
# Use project deps (pytz, ib_insync, …). From pythonclient/:
#   ./py -m pip install -r requirements.txt       # install/upgrade deps (no global `pip` needed)
#   PYTHONPATH=src ./py -m uvicorn zone_validation_app.main:app --port 8766  # zone chart UI (not brew uvicorn)
#   ./py src/main.py --paper                     # paper trading (now has strict PDT/settlement gates)
#   PYTHONPATH=. ./py src/main.py --paper --watch  # watch: paper FLATTENS ALL PORTFOLIO STK SHORTS (--no-flatten-paper-shorts to skip); --allow-watchlist-net-short bypasses watchlist net-short abort
#   PYTHONPATH=src ./py scripts/prefetch_ib_bars_cache.py SYMBOL --duration "6 M" --bar-size "15 mins"
#       # CSV cache lives in historical_data/ (gitignored); main/batch use --historical-data-dir default there
#   ./py src/main.py --paper --lax-paper         # disable gates for diagnostics only
#   ./py src/journal_dashboard.py                # trade journal / IB P&L UI (default :8765)
#
# Logging is now daily-rotated (logs/stock_analysis_YYYYMMDD.log, etc.)
# Old logs are kept for 30 days. No more multi-million line files.
cd "$(dirname "$0")" || exit 1
exec ./.bt_run_venv/bin/python3 "$@"
